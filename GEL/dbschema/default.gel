module default {
  scalar type SourceKind extending enum<pdf, conversation>;
  scalar type VerificationStatus extending enum<candidate, machine_checked, pending_review, needs_revision, human_verified, ready_for_writeback, rejected>;
  scalar type ReviewDecision extending enum<approved, rejected, revised>;
  scalar type GovernanceRunStatus extending enum<passed, needs_review, rejected>;
  scalar type GovernanceIssueSeverity extending enum<info, warning, error>;
  scalar type CandidateKind extending enum<node, claim, relation>;
  scalar type ReviewTaskStatus extending enum<pending, approved, rejected, revised>;
  scalar type WritebackStatus extending enum<effects_pending, retryable_failed, completed, reverted>;
  scalar type JobStatus extending enum<queued, running, retrying, succeeded, failed, cancelled>;

  abstract type Timestamped {
    required created_at: datetime { default := datetime_current(); };
  };

  type Project extending Timestamped {
    required name: str;
    required slug: str { constraint exclusive; };
  };

  type Source extending Timestamped {
    required kind: SourceKind;
    required title: str;
    required project: Project;
  };

  type SourceVersion extending Timestamped {
    required version: int16 { constraint min_value(1); };
    required content_hash: str;
    required object_key: str;
    required source: Source;
    constraint exclusive on ((.source, .content_hash));
    constraint exclusive on ((.source, .version));
  };

  type ContentBlock extending Timestamped {
    required ordinal: int32 { constraint min_value(0); };
    required content: str;
    required content_hash: str;
    required locator: json { default := <json>{}; };
    required source_version: SourceVersion;
    constraint exclusive on ((.source_version, .ordinal));
  };

  type Conversation extending Timestamped {
    required external_id: str;
    required title: str;
    required metadata: json { default := <json>{}; };
    required project: Project;
    required source: Source;
    constraint exclusive on ((.project, .external_id));
  };

  type ConversationMessage extending Timestamped {
    required external_id: str;
    required role: str;
    required content: str;
    required ordinal: int32 { constraint min_value(0); };
    required content_hash: str;
    parent_external_id: str;
    required attachments: json { default := <json>{}; };
    required conversation: Conversation;
    constraint exclusive on ((.conversation, .external_id));
  };

  type KnowledgeNode extending Timestamped {
    required node_type: str;
    required title: str;
    required properties: json { default := <json>{}; };
    required status: VerificationStatus { default := VerificationStatus.candidate; };
    required project: Project;
  };

  type Citation extending Timestamped {
    required quote: str;
    required locator: json { default := <json>{}; };
    required metadata: json { default := <json>{}; };
    required content_block: ContentBlock;
  };

  type Claim extending Timestamped {
    required statement: str;
    confidence: float32 {
      constraint min_value(0);
      constraint max_value(1);
    };
    required status: VerificationStatus { default := VerificationStatus.candidate; };
    required metadata: json { default := <json>{}; };
    required project: Project;
    required subject: KnowledgeNode;
    required multi citations: Citation;
  };

  type RelationType extending Timestamped {
    required key: str { constraint exclusive; };
    required label: str;
    required description: str { default := ''; };
    required directional: bool { default := true; };
  };

  type Relation extending Timestamped {
    confidence: float32 {
      constraint min_value(0);
      constraint max_value(1);
    };
    required properties: json { default := <json>{}; };
    required status: VerificationStatus { default := VerificationStatus.candidate; };
    required metadata: json { default := <json>{}; };
    required project: Project;
    required relation_type: RelationType;
    required source: KnowledgeNode;
    required target: KnowledgeNode;
    required multi citations: Citation;
  };

  type ReviewRecord extending Timestamped {
    required target_id: uuid;
    required reviewer_id: str;
    required decision: ReviewDecision;
    required note: str { default := ''; };
    required before: json { default := <json>{}; };
    required after: json { default := <json>{}; };
  };

  type GovernanceRun extending Timestamped {
    required project: Project;
    required task_id: uuid;
    required rule_version: str;
    required status: GovernanceRunStatus;
    required multi candidate_ids: uuid;
  };

  type GovernanceIssue extending Timestamped {
    required run: GovernanceRun;
    required candidate_id: uuid;
    required candidate_kind: CandidateKind;
    required code: str;
    required message: str;
    required severity: GovernanceIssueSeverity;
  };

  type DuplicateGroup extending Timestamped {
    required project: Project;
    required multi candidate_ids: uuid;
    required basis: str;
  };

  type ConflictRecord extending Timestamped {
    required project: Project;
    required multi candidate_ids: uuid;
    required basis: str;
    required status: str { default := 'open'; };
  };

  type ReviewTask extending Timestamped {
    required run: GovernanceRun;
    required candidate_id: uuid;
    required candidate_kind: CandidateKind;
    required status: ReviewTaskStatus { default := ReviewTaskStatus.pending; };
    reviewer_id: str;
    reason: str;
    required before: json { default := <json>{}; };
    required after: json { default := <json>{}; };
    required version: int32 { default := 1; constraint min_value(1); };
    reviewed_at: datetime;
  };

  type WritebackRecord extending Timestamped {
    required project: Project;
    required governance_run: GovernanceRun;
    required schema_namespace: str;
    required schema_version: int32 { constraint min_value(1); };
    required idempotency_key: str { constraint exclusive; };
    required request_digest: str;
    required candidate_digest: str;
    required candidates: json { default := <json>{}; };
    required status: WritebackStatus { default := WritebackStatus.effects_pending; };
    effects_job_id: uuid;
    okf_object_key: str;
    index_job_id: uuid;
    error_code: str;
    error_digest: str;
    committed_at: datetime;
    completed_at: datetime;
  };

  type WritebackItem extending Timestamped {
    required record: WritebackRecord;
    required candidate_id: uuid;
    required candidate_kind: CandidateKind;
    required before_status: VerificationStatus;
    required after_status: VerificationStatus;
    required before_digest: str;
    required after_digest: str;
    required result: str;
  };

  type Job extending Timestamped {
    required kind: str;
    required idempotency_key: str { constraint exclusive; };
    required payload: json { default := <json>{}; };
    required status: JobStatus { default := JobStatus.queued; };
    required progress: int16 {
      default := 0;
      constraint min_value(0);
      constraint max_value(100);
    };
    required stage: str { default := 'queued'; };
    required attempt: int16 { default := 0; constraint min_value(0); };
    required max_attempts: int16 { default := 3; constraint min_value(1); };
    required timeout_seconds: int32 { default := 900; constraint min_value(1); };
    failure_reason: str;
    next_attempt_at: datetime;
    started_at: datetime;
    finished_at: datetime;
  };

  # P10-F immutable audit stream. ``id`` is the event_id used by the domain.
  type AuditEvent extending Timestamped {
    required event_type: str;
    required schema_version: str;
    required trace_id: str;
    span_id: str;
    parent_span_id: str;
    request_id: str;
    required actor_type: str;
    actor_id: str;
    required entity_type: str;
    entity_id: str;
    required status: str;
    reason_code: str;
    before_digest: str;
    after_digest: str;
    project_id: uuid;
    required metadata: json { default := <json>{}; };
    required sequence: int64 { constraint exclusive; };
    prev_hash: str;
    required event_hash: str { constraint exclusive; };
  };

  type AuditChainHead {
    required key: str { constraint exclusive; };
    required sequence: int64 { default := 0; };
    event_hash: str;
  };
}
