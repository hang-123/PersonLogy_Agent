{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.person-knowledge.dev/schemas/capture-event.v1.json",
  "title": "PersonLogy Capture Event Batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "producer_id",
        "stream_id",
        "sequence",
        "source",
        "captured_at",
        "rule_version",
        "payload_hash",
        "payload"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "event_id": { "type": "string", "format": "uuid" },
        "producer_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "stream_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "sequence": { "type": "integer", "minimum": 1 },
        "source": { "$ref": "#/$defs/source" },
        "occurred_at": { "type": ["string", "null"], "format": "date-time" },
        "captured_at": { "type": "string", "format": "date-time" },
        "rule_version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "payload_hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "payload": { "type": "object" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "scope", "session_key", "item_key", "revision"],
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 100 },
        "scope": { "type": "string", "minLength": 1, "maxLength": 255 },
        "session_key": { "type": "string", "minLength": 1, "maxLength": 255 },
        "item_key": { "type": "string", "minLength": 1, "maxLength": 255 },
        "revision": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
