POSTGRES_DB=knowledge
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=local-only-change-me
NEO4J_AUTH=neo4j/local-only-change-me

PKS_ENVIRONMENT=local
PKS_LOG_LEVEL=INFO
PKS_STORAGE_BACKEND=sqlite
PKS_SQLITE_PATH=../../data/personlogy.sqlite3
PKS_PDF_STORAGE_ROOT=../../data/files
PKS_PDF_MAX_SIZE_BYTES=26214400
PKS_QUEUE_BACKEND=sqlite
# 切换到 Gel 后端时（本机 my-gel 示例；数据库需已应用 GEL/dbschema 迁移）：
# PKS_STORAGE_BACKEND=gel
# PKS_QUEUE_BACKEND=gel
# PKS_GEL_DSN=gel://edgedb@localhost:5656/personlogy?tls_security=insecure
PKS_GEL_DSN=
PKS_DATABASE_URL=postgresql+psycopg://knowledge:local-only-change-me@postgres:5432/knowledge
PKS_NEO4J_URI=bolt://neo4j:7687
PKS_NEO4J_USERNAME=neo4j
PKS_NEO4J_PASSWORD=local-only-change-me
PKS_CORS_ORIGINS=["http://localhost:5173"]

# --- LLM / Embedding / Rerank（OpenAI 兼容接口，全部可选）---
# 知识编译：把启发式编译替换为真实 LLM。provider 设为 openai_compatible 并填
# base_url/api_key/model 即启用；保持 none 则继续用本地启发式。
#   DeepSeek:   base_url=https://api.deepseek.com/v1  model=deepseek-chat
#   OpenAI:     base_url=https://api.openai.com/v1     model=gpt-4o-mini
#   本地 Ollama: base_url=http://localhost:11434/v1    model=qwen2.5:7b（无需 key）
# PKS_LLM_PROVIDER=none
# PKS_LLM_BASE_URL=
# PKS_LLM_API_KEY=
# PKS_LLM_MODEL=
#
# 向量 Embedding（当前检索仍为 BM25 全文；此配置暴露 provider 实例供后续混合检索接入）：
#   OpenAI: text-embedding-3-small | DeepSeek 暂未提供 embeddings 端点
# PKS_EMBEDDING_PROVIDER=none
# PKS_EMBEDDING_BASE_URL=
# PKS_EMBEDDING_API_KEY=
# PKS_EMBEDDING_MODEL=
#
# 重排（Cohere 兼容 /rerank 端点；当前 pipeline 尚未消费，属预留）：
# PKS_RERANK_PROVIDER=none
# PKS_RERANK_BASE_URL=
# PKS_RERANK_API_KEY=
# PKS_RERANK_MODEL=
